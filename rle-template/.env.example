# Copy to .env and fill in before using RealFoundryClient.
# The stub client (used by run_smoke_test.py) needs none of this.

FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com
FOUNDRY_AGENT_ID=<your-hosted-agent-id>

# If using Agent Optimizer or eval-harness/ against real traces:
FOUNDRY_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
